+}
+
+fn censor_email(email: &str) -> String {
+    if std::env::var("DEBUG_SENSITIVE").is_ok() {
+        return email.to_string();
+    }
+    if let Some(at_pos) = email.find('@') {
+        let (local, domain) = email.split_at(at_pos);
+        if local.len() <= 2 {
+            format!("{}***{}", &local[0..1], &domain)
+        } else {
+            format!(
+                "{}***{}{}",
+                &local[0..1],
+                &local[local.len() - 1..],
+                &domain
+            )
+        }
+    } else {
+        "***".to_string()
+    }
+}
